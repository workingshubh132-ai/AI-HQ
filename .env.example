# ─────────────────────────────────────────────────────────────
# AI-HQ — EXAMPLE environment file
#
# This file is COMMITTED to GitHub on purpose. It contains
# placeholders only — never real values.
#
# To use it:
#   1. Make a copy named ".env"
#   2. Replace the placeholder values with your real ones
#   3. Never commit ".env" (.gitignore already blocks it)
# ─────────────────────────────────────────────────────────────

# Which mode the project is running in: development | production
NODE_ENV=development


# ── Supabase (database) ──────────────────────────────────────
# NOT USED YET. These are added in the next milestone.
# Left here so you can see the shape of what is coming.

# The web address of your Supabase project
SUPABASE_URL=https://your-project-id.supabase.co

# Public key. Safe to use in a browser. Limited permissions.
SUPABASE_ANON_KEY=replace-with-your-anon-key

# ⚠️  ADMIN KEY — full access, ignores all security rules.
# Server-side only. Never put this in dashboard/browser code.
# Anyone holding this key controls the entire database.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
