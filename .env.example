# ─────────────────────────────────────────────────────────────
# AI-HQ — EXAMPLE environment file
#
# This file is COMMITTED to GitHub on purpose. It contains
# placeholders only — never real values.
#
# To use it:
#   1. Make a copy named ".env"
#   2. Replace the placeholder values with your real ones
#   3. Never commit ".env" (.gitignore already blocks it)
# ─────────────────────────────────────────────────────────────

# Which mode the project is running in: development | production
NODE_ENV=development


# ── Supabase (database) ──────────────────────────────────────
# Schema exists (supabase/migrations/) and a real Postgres adapter exists
# (src/postgres-store.js, M11) but NEITHER IS WIRED INTO THE LIVE SYSTEM
# YET — broker.js/runtime.js/workflow.js/router.js/guardian.js all still
# run against the synchronous in-memory store (src/store.js). See
# DECISIONS.md D28 for why that is a deliberate, explained boundary, not
# an oversight.

# The web address of your Supabase project
SUPABASE_URL=https://your-project-id.supabase.co

# Public key. Safe to use in a browser. Limited permissions.
SUPABASE_ANON_KEY=replace-with-your-anon-key

# ⚠️  ADMIN KEY — full access, ignores all security rules.
# Server-side only. Never put this in dashboard/browser code.
# Anyone holding this key controls the entire database.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key


# ── Direct Postgres connection (M11) ─────────────────────────
# Read by scripts/migrate.mjs to apply supabase/migrations/*.sql, and by
# a future caller of src/postgres-store.js. A real Supabase project's
# "Connection string" (Postgres, not the REST API) goes here — never a
# value resembling one committed to this file.
AI_HQ_DATABASE_URL=postgres://user:password@host:5432/database

# Local development / test-suite use ONLY — a throwaway database on your
# own machine, never a hosted or production one. Kept as a SEPARATE
# variable from AI_HQ_DATABASE_URL on purpose: the test suite truncates
# and creates/drops databases freely, and must never be able to do that
# to a real project just because both variables happened to be set to
# the same value. See tests/postgres-store.test.js and
# tests/storage-contract.test.js, which are skipped (not failed) when
# this is unset.
AI_HQ_TEST_DATABASE_URL=postgres://localhost:5432/ai_hq_test


# ── Real model provider — Anthropic (M12) ────────────────────
# Read ONLY inside src/provider-anthropic.js's invoke(), at call time —
# nowhere else in this codebase reads this variable, no agent ever
# receives it, and it never appears in an audit record or a returned
# envelope (see DECISIONS.md D29 and test 247). Like AI_HQ_DATABASE_URL,
# this provider exists and is genuinely tested (src/provider-anthropic.js,
# src/async-model-runtime.js) but is NOT wired into the live synchronous
# system — see D29 for why, the same reasoning as D28.
#
# Get a key from https://console.anthropic.com/ if you want to actually
# exercise this against the real API. Never paste a real key into a chat
# session with an AI assistant, including this one — set it here, in a
# local .env file that is never committed, or in your deployment's own
# secret manager.
ANTHROPIC_API_KEY=replace-with-your-real-key


# ── Real model provider — GROQ (M25) ─────────────────────────
# The FIRST real, paid, external inference provider wired into
# src/providers/. Everything below is OFF by default: with none of these
# set, AI-HQ makes zero network calls, needs zero credentials, and runs
# entirely on the deterministic fixture providers. See docs/PROVIDERS.md
# §4 and DECISIONS.md D42.
#
# THREE INDEPENDENT GATES must ALL be satisfied before one real call is
# made. A key alone is deliberately NOT enough.

# GATE 1 — project-wide opt-in to ANY real provider. Anything other than
# the exact string "true" keeps the whole system offline.
AI_HQ_REAL_PROVIDER_ENABLED=false

# GATE 2 — per-provider off switch. Set to "false" to disable Groq
# specifically without disabling other providers.
GROQ_ENABLED=

# GATE 3a — your Groq API key, from https://console.groq.com/keys
# Read ONLY inside src/providers/groq.js's invoke(), at call time, and
# placed ONLY in the outbound Authorization header. It never enters an
# audit record, an artifact, a prompt, a request body, an error message,
# or any value returned to an agent or the CEO (tests 690-696).
# Never paste a real key into a chat session with an AI assistant,
# including this one — put it in a local .env (.gitignore already blocks
# it) or your deployment's secret manager.
GROQ_API_KEY=

# GATE 3b — a HARD spending ceiling in USD, per call, reserved by the
# existing resource governor before any request is sent. There is no
# "unlimited": undefined, empty, NaN, Infinity, and negative values are
# ALL rejected and disable the provider (tests 701-702).
GROQ_MAX_SPEND_USD=

# The allowlist of Groq model IDs this deployment may use, comma
# separated. AI-HQ ships NO default model name on purpose — Groq's
# supported model list changes over time, and inventing one would be
# fabrication. Look up the current list at
# https://console.groq.com/docs/models and put the ones you want here.
# A request naming anything outside this list fails closed (test 705).
GROQ_MODELS=

# Optional. Defaults to https://api.groq.com/openai/v1. Only an https://
# origin is accepted — a plain-http override is refused rather than
# downgrading a credential-bearing request (test 703).
GROQ_BASE_URL=
